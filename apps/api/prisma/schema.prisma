// LuxeCraft — Prisma Schema
// Phase 4: Cart & Wishlist
// Phase 1, 2 & 3 models retained.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// FOUNDATION — Phase 1
// ============================================================

model SchemaVersion {
  id          Int      @id @default(autoincrement())
  version     String   @unique
  description String
  appliedAt   DateTime @default(now())

  @@map("schema_versions")
}

// ============================================================
// AUTHENTICATION — Phase 2
// ============================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?
  passwordHash      String?
  firstName         String?
  lastName          String?
  phone             String?
  country           String?
  status            UserStatus @default(ACTIVE)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  sessions          Session[]
  otpCodes          OtpCode[]
  passwordResets    PasswordResetToken[]
  loginAttempts     LoginAttempt[]
  carts             Cart[]
  wishlists         Wishlist[]

  @@index([email])
  @@index([status])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

model OtpCode {
  id         String      @id @default(cuid())
  userId     String?
  email      String
  code       String
  purpose    OtpPurpose
  used       Boolean     @default(false)
  attempts   Int         @default(0)
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
  usedAt     DateTime?

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, purpose])
  @@index([code])
  @@index([expiresAt])
  @@map("otp_codes")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  CHECKOUT_VERIFICATION
  LOGIN_VERIFICATION
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  used      Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model LoginAttempt {
  id          String   @id @default(cuid())
  email       String
  userId      String?
  ipAddress   String?
  userAgent   String?
  success     Boolean
  failReason  String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_attempts")
}

model AdminUser {
  id                  String          @id @default(cuid())
  email               String          @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                AdminRole       @default(SUPER_ADMIN)
  status              AdminStatus     @default(ACTIVE)
  twoFactorEnabled    Boolean         @default(false)
  twoFactorSecret     String?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  createdBy           String?

  sessions            AdminSession[]
  auditLogs           AuditLog[]
  inventoryLogs       InventoryLog[]

  @@index([email])
  @@index([status])
  @@map("admin_users")
}

enum AdminRole {
  SUPER_ADMIN
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

model AdminSession {
  id           String      @id @default(cuid())
  adminId      String
  refreshToken String      @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime    @default(now())

  admin        AdminUser   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([refreshToken])
  @@map("admin_sessions")
}

model AuditLog {
  id         String     @id @default(cuid())
  adminId    String?
  actor      String?
  actorType  String     @default("system")
  action     String
  resource   String
  resourceId String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([actor])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// CATALOG — Phase 3
// ============================================================

/// Product category. Supports hierarchy (parentId), ordering, SEO, image, soft-delete.
model Category {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  description   String?
  parentId      String?
  sortOrder     Int             @default(0)
  status        CategoryStatus  @default(ACTIVE)

  // Image — either uploaded (stored in object storage) or external URL
  imageUrl      String?
  imageKey      String?         // S3/R2 object key if uploaded
  imageAlt      String?

  // SEO
  seoTitle      String?
  seoDesc       String?

  // Timestamps & soft-delete
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  archivedAt    DateTime?
  deletedAt     DateTime?       // soft-delete; null = not deleted

  // Relations
  parent        Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[]      @relation("CategoryTree")
  products      Product[]

  @@index([slug])
  @@index([status])
  @@index([parentId])
  @@index([sortOrder])
  @@map("categories")
}

enum CategoryStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
}

/// Product. Linked to a category. Supports variants, media, customization, SEO, soft-delete.
model Product {
  id               String          @id @default(cuid())
  categoryId       String?
  name             String
  slug             String          @unique
  sku              String?         @unique
  description      String?
  shortDescription String?

  // Pricing (base — variants can override)
  regularPrice     Decimal         @db.Decimal(12, 2)
  salePrice        Decimal?        @db.Decimal(12, 2)
  currency         String          @default("USD")

  // Status & visibility
  status           ProductStatus   @default(DRAFT)

  // Physical dimensions (base — variants can override)
  weightKg         Decimal?        @db.Decimal(8, 3)
  lengthCm         Decimal?        @db.Decimal(8, 2)
  widthCm          Decimal?        @db.Decimal(8, 2)
  heightCm         Decimal?        @db.Decimal(8, 2)

  // SEO
  seoTitle         String?
  seoDesc          String?

  // Flags
  trackInventory   Boolean         @default(true)
  allowBackorder   Boolean         @default(false)
  isFeatured       Boolean         @default(false)
  isCustomizable   Boolean         @default(false)

  // Timestamps & soft-delete
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  publishedAt      DateTime?
  archivedAt       DateTime?
  deletedAt        DateTime?

  // Relations
  category         Category?       @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  media            ProductMedia[]
  customizationOptions ProductCustomizationOption[]
  inventoryLogs    InventoryLog[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]

  @@index([categoryId])
  @@index([slug])
  @@index([sku])
  @@index([status])
  @@index([isFeatured])
  @@map("products")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

/// A specific variant of a product (e.g. 5x7 / Standard, 8x10 / Premium).
model ProductVariant {
  id             String    @id @default(cuid())
  productId      String
  name           String                    // e.g. "8x10 / Premium"
  sku            String?   @unique
  sortOrder      Int       @default(0)

  // Pricing (overrides product if set)
  regularPrice   Decimal?  @db.Decimal(12, 2)
  salePrice      Decimal?  @db.Decimal(12, 2)

  // Physical (overrides product if set)
  weightKg       Decimal?  @db.Decimal(8, 3)
  lengthCm       Decimal?  @db.Decimal(8, 2)
  widthCm        Decimal?  @db.Decimal(8, 2)
  heightCm       Decimal?  @db.Decimal(8, 2)

  // Inventory
  stockQty       Int       @default(0)
  reservedQty    Int       @default(0)
  lowStockAt     Int?      // threshold for low-stock alert
  trackInventory Boolean   @default(true)
  allowBackorder Boolean   @default(false)
  isAvailable    Boolean   @default(true)

  // Timestamps & soft-delete
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLogs  InventoryLog[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]

  @@index([productId])
  @@index([sku])
  @@index([sortOrder])
  @@map("product_variants")
}

/// Product image or video. Supports both uploaded files and external URLs.
model ProductMedia {
  id          String         @id @default(cuid())
  productId   String
  type        MediaType      @default(IMAGE)
  url         String                           // CDN or external URL (always set)
  storageKey  String?                          // object-storage key if uploaded
  altText     String?
  sortOrder   Int            @default(0)
  isMain      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isMain])
  @@index([sortOrder])
  @@map("product_media")
}

enum MediaType {
  IMAGE
  VIDEO
}

/// Predefined customization options (e.g. Size, Color, Material) with optional price delta.
model ProductCustomizationOption {
  id           String    @id @default(cuid())
  productId    String
  groupName    String                  // e.g. "Size", "Color", "Material"
  optionLabel  String                  // e.g. "Large", "Red", "Silk"
  priceDelta   Decimal   @default(0) @db.Decimal(10, 2)
  sortOrder    Int       @default(0)
  isAvailable  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([groupName])
  @@map("product_customization_options")
}

/// Inventory adjustment history. Covers manual adjustments, order reservations, and releases.
model InventoryLog {
  id          String           @id @default(cuid())
  productId   String?
  variantId   String?
  adminId     String?
  changeType  InventoryChange
  delta       Int                        // positive = stock in, negative = stock out
  qtyBefore   Int
  qtyAfter    Int
  reason      String?
  reference   String?                    // order ID, return ID, etc.
  createdAt   DateTime         @default(now())

  product     Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  admin       AdminUser?       @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([changeType])
  @@index([createdAt])
  @@map("inventory_logs")
}

enum InventoryChange {
  MANUAL_ADJUST
  ORDER_RESERVE
  ORDER_RELEASE
  ORDER_DEDUCT
  RETURN_RESTOCK
  INITIAL_STOCK
  CORRECTION
}

// ============================================================
// CART & WISHLIST — Phase 4
// ============================================================

/// Shopping cart. Supports guest (sessionId) and customer (userId) carts.
model Cart {
  id          String    @id @default(cuid())
  userId      String?                   // null = guest cart
  sessionId   String?   @unique          // for guest carts
  currency    String    @default("USD")
  expiresAt   DateTime?                 // cart expiry for guest carts
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("carts")
}

/// Cart item. References product + optional variant. Stores customization snapshot.
model CartItem {
  id              String    @id @default(cuid())
  cartId          String
  productId       String
  variantId       String?
  quantity        Int       @default(1)
  customization   Json?                 // selected customization options snapshot
  priceSnapshot   Decimal   @db.Decimal(12, 2)  // price at time of add-to-cart
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cart            Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

/// Customer wishlist. Customer-only feature.
model Wishlist {
  id          String    @id @default(cuid())
  userId      String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       WishlistItem[]

  @@map("wishlists")
}

/// Wishlist item. References product + optional variant.
model WishlistItem {
  id          String    @id @default(cuid())
  wishlistId  String
  productId   String
  variantId   String?
  createdAt   DateTime  @default(now())

  wishlist    Wishlist          @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId, variantId])
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_items")
}
